# InfluxDB-Zugangsdaten für den gemeinsamen Bucket der Spielstationen.
#
# Diese Datei ist nur eine Vorlage - kopiere sie nach `.env` und ersetze die
# Platzhalter durch die tatsächlichen Werte. `.env` steht in .gitignore und
# wird deshalb nicht committet.
#
# WICHTIG: Trage die API-Tokens NUR in `.env` ein, niemals hier.

INFLUX_URL=http://10.0.244.254:8086
INFLUX_ORG=FIT244
INFLUX_BUCKET=PPMaster
INFLUX_BUCKET_ID=0a38c021dbad8b0c

# Token mit Leserechten für den Bucket
INFLUX_TOKEN_READ=<HIER LESE-TOKEN EINTRAGEN>

# Token mit Schreibrechten für den Bucket
INFLUX_TOKEN_WRITE=<HIER SCHREIB-TOKEN EINTRAGEN>

# Zeitrahmen für die Punktesumme aus dem Bucket (default: letzte Stunde)
INFLUX_QUERY_RANGE=-1h
