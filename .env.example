# Zugangsdaten für die InfluxDB-Instanz (Guthaben-Datenbank).
#
# Diese Datei nach `.env` kopieren und die Platzhalter durch die
# tatsächlichen Werte aus dem InfluxDB-Portal ersetzen. `.env` selbst
# wird durch .gitignore vom Commit ausgeschlossen.

# URL des InfluxDB-Servers. Für InfluxDB Cloud EU steht in der
# Adressleiste z. B. https://eu-central-1-1.aws.cloud2.influxdata.com
INFLUX_URL=https://eu-central-1-1.aws.cloud2.influxdata.com

# Organisations-ID (im UI: Data -> API Tokens, oder "About" oben rechts)
INFLUX_ORG_ID=YOUR_ORG_ID

# Bucket-Name (menschlich lesbar) und Bucket-ID
INFLUX_BUCKET=blackjack
INFLUX_BUCKET_ID=YOUR_BUCKET_ID

# API-Token mit Lese- und Schreibrechten auf den obigen Bucket
INFLUX_TOKEN=YOUR_TOKEN
